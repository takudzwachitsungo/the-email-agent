        </mxCell>

        <mxCell id="svc" value="FastAPI service — one container, one process" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#6b46c1;fillColor=#f3effc;strokeColor=#8b5cf6;dashed=1;" vertex="1" parent="1">
